. *==============================================================================*
. * 5. BASELINE ESTIMATION
. *==============================================================================*
. * Estimated in levels, Helmert-transformed (forward orthogonal deviations,
. * the pvar default). FOD is preferred to first differencing here because it
. * leaves the transformed errors serially uncorrelated and, with the four
. * internal gaps in this panel, destroys one observation per gap rather than
. * two.
. 
. capture postclose gate

. postfile gate str4 tdopt double(nobs ncty jstat jdf jp maxmod resid_corr) ///
>     str24 note using "$TABLES/gatekeepers_${TAG}.dta", replace
(file C:/Users/Benedikt/PycharmProjects/terror_and_fdi/output/tables/gatekeepers_attacks_total_fdi_in_pct_qgdp_core_min28.dta not found)

. 
. foreach td in "" "td" {
  2. 
.     local tdlab = cond("`td'" == "", "notd", "td")
  3.     local xopt  = cond("`td'" == "", "exog(`SEAS')", "")
  4. 
.     di as txt _n "{hline 78}"
  5.     di as txt "BASELINE PVAR: lags($P), instlags(1/$K), `tdlab'"
  6.     di as txt "  Cholesky order for part 3: `SYS'  (terror first)"
  7.     di as txt "{hline 78}"
  8. 
.     cap noisily pvar `SYS' if insample, lags($P) instlags(1/$K) `xopt' `td'
  9.     if _rc {
 10.         di as error "Baseline estimation failed (rc = " _rc "); skipping `tdlab'."
 11.         continue
 12.     }
 13. 
.     local nobs_b = e(N)
 14.     local ncty_b = e(N_g)
 15.     local jstat  = .
 16.     local jdf    = .
 17.     local jp     = .
 18.     foreach nm in J j {
 19.         if missing(`jstat') local jstat = e(`nm')
 20.     }
 21.     foreach nm in J_df j_df Jdf {
 22.         if missing(`jdf') local jdf = e(`nm')
 23.     }
 24.     foreach nm in J_pvalue jp J_p {
 25.         if missing(`jp') local jp = e(`nm')
 26.     }
 27. 
.     * Store for the impulse responses in part 3.
.     estimates store pvar_`tdlab'
 28.     cap estimates save "$ESTS/pvar_${TAG}_l${P}_`tdlab'.ster", replace
 29. 
.     *--- Gatekeeper 1: eigenvalue stability ---------------------------------*
.     di as txt _n "--- Eigenvalue stability ---"
 30.     local maxmod = .
 31.     cap noisily pvarstable
 32.     if !_rc {
 33.         tempname MOD
 34.         cap matrix `MOD' = r(Modulus)
 35.         if _rc cap matrix `MOD' = r(modulus)
 36.         if !_rc {
 37.             local maxmod = 0
 38.             forvalues rr = 1/`=rowsof(`MOD')' {
 39.                 forvalues cc = 1/`=colsof(`MOD')' {
 40.                     if `MOD'[`rr', `cc'] > `maxmod' & !missing(`MOD'[`rr', `cc']) {
 41.                         local maxmod = `MOD'[`rr', `cc']
 42.                     }
 43.                 }
 44.             }
 45.         }
 46.     }
 47.     if !missing(`maxmod') & `maxmod' > 0 & `maxmod' < 1 {
 48.         local halflife = ln(0.5) / ln(`maxmod')
 49.         di as txt "  Largest modulus: " %6.4f `maxmod'
 50.         di as txt "  Implied half-life of the most persistent root: " ///
>             %5.1f `halflife' " quarters"
 51.         if `maxmod' > 0.95 {
 52.             di as error "  Formally stable but near-integrated: the impulse"
 53.             di as error "  response bands will be wide and asymmetric."
 54.         }
 55.     }
 56. 
.     *--- Gatekeeper 2: Hansen J ---------------------------------------------*
.     di as txt _n "--- Overidentification ---"
 57.     di as txt "  Hansen J = " %8.3f `jstat' "  df = " `jdf' "  p = " %6.3f `jp'
 58.     local nvar  = wordcount("`SYS'")
 59.     local ninst = `nvar' * $K + cond("`td'" == "", wordcount("`SEAS'"), 0)
 60.     di as txt "  Instruments per equation: " `ninst' ///
>         "   Countries: " `ncty_b'
 61.     if !missing(`jp') {
 62.         if `jp' > 0.25 {
 63.             di as error "  J p-value above 0.25: check the instrument count"
 64.             di as error "  before reading this as evidence of validity."
 65.         }
 66.         if `jp' < 0.05 {
 67.             di as error "  J rejects. Possible causes, in order of plausibility:"
 68.             di as error "   (a) an omitted, serially correlated determinant of"
 69.             di as error "       FDI sitting in the error term;"
 70.             di as error "   (b) too few lags, leaving serial correlation;"
 71.             di as error "   (c) genuinely invalid instruments."
 72.         }
 73.     }
 74. 
.     *--- Granger causality ---------------------------------------------------*
.     di as txt _n "--- Granger causality (Wald tests on the lag blocks) ---"
 75.     cap noisily pvargranger
 76. 
.     *--- Residual correlation: does the Cholesky ordering matter? -----------*
.     * If the reduced-form residuals are close to uncorrelated, A is close to
.     * diagonal and the ordering is nearly irrelevant. That is the cleanest
.     * defence of the recursive identification used in part 3.
.     local rcorr = .
 77.     tempname SIG
 78.     cap matrix `SIG' = e(Sigma)
 79.     if !_rc {
 80.         if rowsof(`SIG') >= 2 {
 81.             local s11 = `SIG'[1,1]
 82.             local s22 = `SIG'[2,2]
 83.             local s12 = `SIG'[1,2]
 84.             if `s11' > 0 & `s22' > 0 {
 85.                 local rcorr = `s12' / sqrt(`s11' * `s22')
 86.             }
 87.         }
 88.     }
 89.     di as txt _n "--- Reduced-form residual correlation ---"
 90.     if !missing(`rcorr') {
 91.         di as txt "  corr(e_terror, e_fdi) = " %6.3f `rcorr'
 92.         if abs(`rcorr') < 0.10 {
 93.             di as txt "  Small: the Cholesky ordering should barely matter."
 94.             di as txt "  Verify this in part 3 by reversing porder()."
 95.         }
 96.         else {
 97.             di as error "  Non-trivial: the impulse responses will depend on the"
 98.             di as error "  ordering. Both orderings must be reported."
 99.         }
100.     }
101.     else {
102.         di as txt "  e(Sigma) not available; compute it from the residuals."
103.     }
104. 
.     post gate ("`tdlab'") (`nobs_b') (`ncty_b') (`jstat') (`jdf') (`jp') ///
>         (`maxmod') (`rcorr') ("lags=$P instlags=1/$K")
105. }

