  |   lag |    CD          J      J pvalue     MBIC       MAIC       MQIC    |
  |-------+------------------------------------------------------------------|
  |     1 |   .859923   443.6181   2.51e-76   188.0055   387.6181   319.7764 |
  |     2 |  .8819758   337.8733   3.67e-57   118.7768   289.8733   231.7233 |
  |     3 |  .8919632   225.1466   1.12e-36   42.56613   185.1466   136.6882 |
  |     4 |  .8997275   81.10439   1.05e-10  -64.95996   49.10439   10.33771 |
  |     5 |  .9011957    67.2824   1.03e-09  -42.26587    43.2824   14.20739 |
  |     6 |  .8981437   50.44413   3.36e-08  -22.58804   34.44413    15.0608 |
  +--------------------------------------------------------------------------+

. if _rc {
.     di as error "pvarsoc with maxlag() failed (rc = " _rc "); trying maxlags()."
.     cap noisily pvarsoc `SYS' if insample, maxlags($MAXLAG) ///
>         pvaropts(instlags(1/`instmax'))
. }

. if _rc {
.     di as error "pvarsoc failed. The manual screen in section 4 still runs and"
.     di as error "provides the information needed to choose a lag order."
. }

. 
. 
. *==============================================================================*
. * 4. MANUAL SCREEN OVER LAG ORDERS
. *==============================================================================*
. * pvarsoc reports fit criteria but not stability. Both gatekeepers matter, so
. * every lag order is estimated and the eigenvalue modulus, Hansen's J, the
. * implied instrument count and the sample size are collected side by side.
. *
. * Reading guide:
. *   max modulus  < 1 required; anything above about 0.95 means the system is
. *                near-integrated and the impulse responses will be imprecise.
. *   Hansen J p   a value in roughly 0.10-0.25 is healthy. A p-value near 1.00
. *                signals instrument proliferation, not a well-specified model.
. *   instruments  should stay far below the number of countries.
. 
. capture postclose lagsel

. postfile lagsel int(lags instlag_max) str4 tdopt ///
>     double(nobs ncty jstat jdf jp maxmod nparam ninst) ///
>     using "$TABLES/lagsel_${TAG}.dta", replace
(file C:/Users/Benedikt/PycharmProjects/terror_and_fdi/output/tables/lagsel_attacks_total_fdi_in_pct_qgdp_core_min28.dta not found)

. 
. foreach td in "" "td" {
  2. 
.     local tdlab = cond("`td'" == "", "notd", "td")
  3.     local xopt  = cond("`td'" == "", "exog(`SEAS')", "")
  4. 
.     di as txt _n "{hline 78}"
  5.     di as txt "Lag screen, time demeaning: `tdlab'"
  6.     di as txt "{hline 78}"
  7. 
.     forvalues p = 1/$MAXLAG {
  8. 
.         local k = `p' + $INSTEXTRA
  9. 
.         local jstat  = .
 10.         local jdf    = .
 11.         local jp     = .
 12.         local maxmod = .
 13.         local nobs_p = .
 14.         local ncty_p = .
 15. 
.         cap noisily pvar `SYS' if insample, lags(`p') instlags(1/`k') ///
>             `xopt' `td'
 16. 
.         if _rc {
 17.             di as error "  lags(`p'), `tdlab': pvar failed (rc = " _rc ")"
 18.         }
 19.         else {
 20.             local nobs_p = e(N)
 21.             local ncty_p = e(N_g)
 22.             foreach nm in J j {
 23.                 if missing(`jstat') local jstat = e(`nm')
 24.             }
 25.             foreach nm in J_df j_df Jdf {
 26.                 if missing(`jdf') local jdf = e(`nm')
 27.             }
 28.             foreach nm in J_pvalue jp J_p {
 29.                 if missing(`jp') local jp = e(`nm')
 30.             }
 31. 
.             * Eigenvalue stability.
.             cap noisily pvarstable
 32.             if !_rc {
 33.                 tempname MOD
 34.                 cap matrix `MOD' = r(Modulus)
 35.                 if _rc cap matrix `MOD' = r(modulus)
 36.                 if !_rc {
 37.                     local maxmod = 0
 38.                     forvalues rr = 1/`=rowsof(`MOD')' {
 39.                         forvalues cc = 1/`=colsof(`MOD')' {
 40.                             if `MOD'[`rr', `cc'] > `maxmod' & ///
>                                !missing(`MOD'[`rr', `cc']) {
 41.                                 local maxmod = `MOD'[`rr', `cc']
 42.                             }
 43.                         }
 44.                     }
 45.                 }
 46.             }
 47.         }
 48. 
.         * Parameters and instruments per equation under IV-style instruments.
.         local nvar   = wordcount("`SYS'")
 49.         local nparam = `nvar' * `p' + cond("`td'" == "", wordcount("`SEAS'"), 0)
 50.         local ninst  = `nvar' * `k' + cond("`td'" == "", wordcount("`SEAS'"), 0)
 51. 
.         di as txt "  lags(`p') instlags(1/`k') `tdlab': " ///
>             "obs = " %7.0fc `nobs_p' ///
>             ", maxmod = " %5.3f `maxmod' ///
>             ", J p = " %5.3f `jp' ///
>             ", inst/eq = " `ninst'
 52. 
.         post lagsel (`p') (`k') ("`tdlab'") (`nobs_p') (`ncty_p') ///
>             (`jstat') (`jdf') (`jp') (`maxmod') (`nparam') (`ninst')
 53.     }
 54. }

