. *==============================================================================*
. * 2b. HELPER
. *==============================================================================*
. capture program drop pvarj

. program define pvarj, rclass
  1.     syntax varlist(min=2) [if], LAGs(integer) ILAgs(integer) ///
>         [TIMEdemean EXOGvars(string)]
  2. 
.     local xopt ""
  3.     if "`exogvars'" != "" local xopt "exog(`exogvars')"
  4.     local tdopt ""
  5.     if "`timedemean'" != "" local tdopt "td"
  6. 
.     tempname J Jdf MOD
  7.     scalar `J'   = .
  8.     scalar `Jdf' = .
  9. 
.     cap pvar `varlist' `if', lags(`lags') instlags(1/`ilags') `xopt' `tdopt'
 10.     if _rc {
 11.         return scalar ok = 0
 12.         return scalar rc = _rc
 13.         exit
 14.     }
 15. 
.     scalar `J'   = e(J)
 16.     scalar `Jdf' = e(J_df)
 17.     local Nobs   = e(N)
 18. 
.     local maxmod = .
 19.     cap pvarstable
 20.     if !_rc {
 21.         cap matrix `MOD' = r(Modulus)
 22.         if _rc cap matrix `MOD' = r(modulus)
 23.         if !_rc {
 24.             local maxmod = 0
 25.             forvalues rr = 1/`=rowsof(`MOD')' {
 26.                 forvalues cc = 1/`=colsof(`MOD')' {
 27.                     if `MOD'[`rr',`cc'] > `maxmod' & !missing(`MOD'[`rr',`cc']) {
 28.                         local maxmod = `MOD'[`rr',`cc']
 29.                     }
 30.                 }
 31.             }
 32.         }
 33.     }
 34. 
.     return scalar ok     = 1
 35.     return scalar N      = `Nobs'
 36.     return scalar J      = `J'
 37.     return scalar Jdf    = `Jdf'
 38.     return scalar Jp     = cond(missing(`J') | missing(`Jdf') | `Jdf' <= 0, ., ///
>                                 chi2tail(`Jdf', `J'))
 39.     return scalar maxmod = `maxmod'
 40. end

. 
. 
