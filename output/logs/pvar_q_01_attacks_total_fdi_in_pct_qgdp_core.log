  3.     qui count if insample & (_sd_`v' == 0 | missing(_sd_`v'))
  4.     if r(N) > 0 {
  5.         di as txt _n "Note: `v' has no within-country variance in " ///
>             %6.0fc r(N) " observations;"
  6.         di as txt "      those panels are excluded from the unit-root tests only."
  7.     }
  8. }
