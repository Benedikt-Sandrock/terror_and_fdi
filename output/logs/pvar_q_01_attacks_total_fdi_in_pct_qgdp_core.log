 48.                 if _rc {
 49.                     tempname M3
 50.                     cap matrix `M3' = r(`nm')
 51.                     if !_rc cap local st = `M3'[1,1]
 52.                     if missing(`st') local st = .
 53.                 }
 54.             }
 55.         }
 56.         post urpost ("`v'") ("CIPS") ("$URTREND") (`st') (.)
 57.         if missing(`st') {
 58.             di as txt "  (CIPS statistic not machine-readable; take it and the"
 59.             di as txt "   critical values from the printed output above)"
 60.         }
 61.     }
 62.     else {
 63.         di as error "  pescadf failed (rc = " _rc ")"
 64.         di as error "  pescadf needs a reasonably balanced panel. If it aborts,"
 65.         di as error "  rerun on countries with maxrun >= 40 (see section 5)."
 66.     }
 67. }

