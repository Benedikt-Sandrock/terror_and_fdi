. foreach g of local grid {
  2. 
.     tokenize "`g'", parse("|")
  3.     local tv   "`1'"
  4.     local lg   "`3'"
  5.     local il   "`5'"
  6.     local tdo  "`7'"
  7.     local slab "`9'"
  8.     local scnd "`11'"
  9. 
.     local xo   = cond("`tdo'" == "", "exog(`SEAS')", "")
 10.     local nx   = cond("`tdo'" == "", 3, 0)
 11.     local tdl  = cond("`tdo'" == "", "notd", "td")
 12. 
.     cap pvar `tv' y_fdi if `scnd', lags(`lg') instlags(1/`il') `xo' `tdo'
 13.     if _rc {
 14.         di as error "  `tv' l`lg' `tdl' `slab': estimation failed"
 15.         continue
 16.     }
 17. 
.     local nb  = e(N)
 18.     local js  = e(J)
 19.     local jd  = e(J_df)
 20.     local jpv = cond(missing(`js') | missing(`jd') | `jd' <= 0, ., ///
>                      chi2tail(`jd', `js'))
 21. 
.     local mm = .
 22.     cap pvarstable
 23.     if !_rc {
 24.         tempname MD
 25.         cap matrix `MD' = r(Modulus)
 26.         if _rc cap matrix `MD' = r(modulus)
 27.         if !_rc {
 28.             local mm = 0
 29.             forvalues rr = 1/`=rowsof(`MD')' {
 30.                 forvalues cc = 1/`=colsof(`MD')' {
 31.                     if `MD'[`rr',`cc'] > `mm' & !missing(`MD'[`rr',`cc']) {
 32.                         local mm = `MD'[`rr',`cc']
 33.                     }
 34.                 }
 35.             }
 36.         }
 37.     }
 38. 
.     tempname G
 39.     cap mata: pvar_oirf("e(b)", "e(Sigma)", 2, `lg', `nx', 20, (1, 2), "`G'")
 40.     if _rc {
 41.         di as error "  `tv' l`lg' `tdl' `slab': IRF computation failed"
 42.         continue
 43.     }
 44. 
.     local c4 = 0
 45.     local c8 = 0
 46.     local c20 = 0
 47.     forvalues h = 1/21 {
 48.         local c20 = `c20' + `G'[`h', 3]
 49.         if `h' <= 5  local c4  = `c4'  + `G'[`h', 3]
 50.         if `h' <= 9  local c8  = `c8'  + `G'[`h', 3]
 51.     }
 52. 
.     di as txt %9s "`tv'" %5.0f `lg' %5.0f `il' %5s "`tdl'" %13s "`slab'" ///
>         %9.0fc `nb' %9.4f `jpv' %8.3f `mm' %10.5f `c4' %10.5f `c8' %10.5f `c20'
 53. 
.     post rob ("`tv'") (`lg') (`il') ("`tdl'") ("`slab'") (`nb') ///
>         (`js') (`jd') (`jpv') (`mm') (`c4') (`c8') (`c20')
 54. }
